{# wpmldev-8628: the icon of a scan-result chip; the chip's text says the state, the icon only repeats it. #}
{% if variant == 'go' %}
<svg class="wpml-media-scan-icon" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2 6.5 5 9.5 10 3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
{% elseif variant == 'skip' %}
<svg class="wpml-media-scan-icon" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2.8 9.2 9.2 2.8" stroke="currentColor" stroke-width="1.4"/></svg>
{% elseif variant == 'unsure' %}
<svg class="wpml-media-scan-icon" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="currentColor"/><path class="wpml-media-scan-icon__mark" d="M4.4 4.7a1.6 1.6 0 1 1 2.4 1.4c-.5.3-.8.6-.8 1.2v.3" fill="none" stroke-width="1.3"/><circle class="wpml-media-scan-icon__dot" cx="6" cy="9.1" r=".75"/></svg>
{% else %}
<svg class="wpml-media-scan-icon" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/></svg>
{% endif %}
