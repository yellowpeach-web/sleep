#: classes/ATE/Handshake/Support/Texts.php:536
msgid "Click <b>Check delivery now</b>. It collects what is waiting and asks the translation system to call your site again, then tells you what happened."
msgstr ""

#. translators: Situation card, "What we recommend". %s: a web address path.
#: classes/ATE/Handshake/Support/Texts.php:546
#, php-format
msgid "If the translation system still cannot reach your site: check that the site is online from outside your network and that %s answers. Then click <b>Check again</b>."
msgstr ""

#. translators: Situation card, "What to do first". %s: a web address path.
#: classes/ATE/Handshake/Support/Texts.php:556
#, php-format
msgid "In your firewall, security plugin or CDN, find the blocked request to %s and allow requests from WPML's translation system to it."
msgstr ""

#. translators: Situation card, "What we recommend". %s: a web address path.
#: classes/ATE/Handshake/Support/Texts.php:566
#, php-format
msgid "Then click <b>Check delivery now</b>: it shows what answers at %s now."
msgstr ""

#. translators: Situation card, "What to do first", for a site that does not collect.
#: classes/ATE/Handshake/Support/Texts.php:572
msgid "Click <b>Collect now</b>."
msgstr ""

#. translators: Situation card, "What we recommend", for a host that stops PHP once the answer is sent.
#: classes/ATE/Handshake/Support/Texts.php:583
msgid "So that your site collects without anyone logged in, ask your host to let PHP finish its work after the answer is sent (PHP-FPM). A real cron job that calls wp-cron.php every 5 minutes also works."
msgstr ""

#. translators: Situation card, "What we recommend", for a site that cannot call its own address.
#: classes/ATE/Handshake/Support/Texts.php:587
msgid "So that your site collects without anyone logged in, ask your host to let the site call its own address. A real cron job that calls wp-cron.php every 5 minutes also works."
msgstr ""

#. translators: End of "What is wrong" for refused keys.
#: classes/ATE/Handshake/Support/Texts.php:601
msgid "it no longer knows this site's access key"
msgstr ""

#. translators: End of "What is wrong" for refused keys.
#: classes/ATE/Handshake/Support/Texts.php:603
msgid "this site's access key is switched off"
msgstr ""

#. translators: End of "What is wrong" for refused keys.
#: classes/ATE/Handshake/Support/Texts.php:605
msgid "this site's keys do not match the ones it holds"
msgstr ""

#. translators: End of "What is wrong" for refused keys, when the reason is not known.
#: classes/ATE/Handshake/Support/Texts.php:608
msgid "it does not accept this site's keys"
msgstr ""

#. translators: Situation card, "What is wrong". %s: why, e.g. "it no longer knows this site's access key".
#: classes/ATE/Handshake/Support/Texts.php:612
#, php-format
msgid "The translation system refuses every call from this site: %s."
msgstr ""

#. translators: Situation card, "What is wrong". %1$s: a date and time; %2$s: why, e.g. "it no longer knows this site's access key".
#: classes/ATE/Handshake/Support/Texts.php:614
#, php-format
msgid "Since %1$s the translation system refuses every call from this site: %2$s."
msgstr ""

#. translators: Situation card, "What to do first", for keys the translation system refuses.
#: classes/ATE/Handshake/Support/Texts.php:620
msgid "Click <b>Register this site again</b>. Waiting does not fix this: your site gets new keys only when it registers again."
msgstr ""

#. translators: Situation card, "What we recommend", for keys the translation system refuses.
#: classes/ATE/Handshake/Support/Texts.php:626
msgid "Then click <b>Check delivery now</b>. If the keys are still refused, click <b>Have questions? Contact us</b>."
msgstr ""

#. translators: "Read together" line, for keys the translation system refuses.
#: classes/ATE/Handshake/Support/Texts.php:632
msgid "The translation system answers this site, but refuses the keys it signs its calls with. Nothing can be sent or collected until the site is registered again."
msgstr ""

#. translators: Situation card, "What is wrong". %1$s: the address the site is registered for; %2$s: the address it runs at.
#: classes/ATE/Handshake/Support/Texts.php:647
#, php-format
msgid "The translation system refuses calls from this site: it is registered for %1$s and now runs at %2$s."
msgstr ""

#. translators: Situation card, "What is wrong", when the translation system no longer recognizes this site at its address.
#: classes/ATE/Handshake/Support/Texts.php:651
msgid "The translation system refuses calls from this site: its registration no longer matches the site's address (the site moved, or it is a copy of another site)."
msgstr ""

#. translators: Situation card, "What to do first", for a site the translation system no longer recognizes at its address.
#: classes/ATE/Handshake/Support/Texts.php:657
msgid "Click <b>Register this site again</b>. Waiting does not fix this: the translation system knows this site only at the address it was registered for."
msgstr ""

#. translators: Situation card, "What we recommend", for a site the translation system no longer recognizes at its address.
#: classes/ATE/Handshake/Support/Texts.php:663
msgid "Then click <b>Check delivery now</b>. If the registration still does not match, click <b>Have questions? Contact us</b>."
msgstr ""

#. translators: "Read together" line, for a site the translation system no longer recognizes at its address.
#: classes/ATE/Handshake/Support/Texts.php:669
msgid "The translation system answers this site, but no longer recognizes it at its address. Nothing can be sent or collected until the site is registered again."
