msgid "This will overwrite content you translated with the WordPress Editor. If you switch now, you'll have to translate selected content again."
msgstr ""

#. translators: Button label that applies the choice made in the dialog; verb, imperative.
msgid "Apply"
msgstr ""

#. translators: Question asked before the language of a post is changed. %s: the title of the post.
#, js-format
msgid "You are about to change the language of %s."
msgstr ""

