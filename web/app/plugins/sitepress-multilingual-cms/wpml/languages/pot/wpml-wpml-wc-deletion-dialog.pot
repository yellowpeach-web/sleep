msgstr ""

msgid "Move to Trash"
msgstr ""

#. translators: Button label that moves on to the next step of a dialog, or confirms and goes ahead, used across WPML's screens. Verb, imperative.
msgid "Continue"
msgstr ""

#. translators: Button label that closes a dialog or a box without applying anything, used across WPML's screens. Verb, imperative, not the status of a cancelled job.
msgid "Cancel"
msgstr ""

#. translators: the accessible name of the dialog.
msgid "Choose a different one"
msgstr ""

