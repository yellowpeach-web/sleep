#: classes/Notice/FieldGroupModes.php:58
msgid "Edit each Field Group to select a translation option for the fields inside it. If you don't set a translation option, you will not be able to translate your fields."
msgstr "Επεξεργαστείτε κάθε ομάδα πεδίων για να επιλέξετε μια προτίμηση μετάφρασης για τα πεδία μέσα σε αυτήν. Εάν δεν ορίσετε μια προτίμηση μετάφρασης, δεν θα μπορείτε να μεταφράσετε τα πεδία σας."

#. translators: %s is the title of the field group being saved.
#: classes/Notice/FieldNameCollisions.php:102
#, php-format
msgid "A field in \"%s\" has the same name as a field in another field group. WPML stores translation preferences by field name, so two fields that share a name cannot be set differently."
msgstr "Ένα πεδίο στο “%s” έχει το ίδιο όνομα με ένα πεδίο σε μια άλλη ομάδα πεδίων. Το WPML αποθηκεύει τις προτιμήσεις μετάφρασης ανά όνομα πεδίου, επομένως δύο πεδία που μοιράζονται ένα όνομα δεν μπορούν να ρυθμιστούν διαφορετικά."

#. translators: %s is the title of the field group being saved.
#: classes/Notice/FieldNameCollisions.php:104
#, php-format
msgid "Some fields in \"%s\" have the same name as fields in other field groups. WPML stores translation preferences by field name, so fields that share a name cannot be set differently."
msgstr "Ορισμένα πεδία στο “%s” έχουν το ίδιο όνομα με πεδία σε άλλες ομάδες πεδίων. Το WPML αποθηκεύει τις προτιμήσεις μετάφρασης ανά όνομα πεδίου, επομένως τα πεδία που μοιράζονται ένα όνομα δεν μπορούν να ρυθμιστούν διαφορετικά."

#. translators: Heading of the admin notice about two fields in different groups sharing a name; "here" is the field group being edited.
#: classes/Notice/FieldNameCollisions.php:107
msgid "What you set here may not be what your visitors get"
msgstr "Αυτό που ορίζετε εδώ μπορεί να μην είναι αυτό που βλέπουν οι επισκέπτες σας"

#. translators: %1$s is a field name, %2$s is the title of another field group.
#: classes/Notice/FieldNameCollisions.php:127
#, php-format
msgid "The field %1$s also exists in \"%2$s\". Rename this field to give it a translation setting of its own."
msgstr "Το πεδίο %1$s υπάρχει επίσης στο “%2$s”. Μετονομάστε αυτό το πεδίο για να του δώσετε μια δική του ρύθμιση μετάφρασης."

#. translators: Link at the end of a line in that notice; it opens the other field group. Verb phrase, imperative.
#: classes/Notice/FieldNameCollisions.php:135
msgid "See both fields"
msgstr "Δείτε και τα δύο πεδία"

#. translators: Button in the admin notice about untranslated media texts; it opens WPML's Media Translation settings. Verb phrase, imperative.
#: classes/Notice/MediaTexts.php:57
msgid "Go to Media Translation settings"
msgstr "Μετάβαση στις ρυθμίσεις μετάφρασης πολυμέσων"

#. translators: Body of the admin notice about untranslated media texts. The quoted text is the name of a WPML setting and is translated the same way there.
#: classes/Notice/MediaTexts.php:110
msgid "This content has ACF image, gallery, or file fields, but the alt text, caption, and title of their media will not be sent for translation. To include them, turn on \"Translate Media Library texts when translating content\" in WPML Media Translation settings."
msgstr "Αυτό το περιεχόμενο διαθέτει πεδία εικόνας, συλλογής ή αρχείου ACF, αλλά το εναλλακτικό κείμενο, η λεζάντα και ο τίτλος των πολυμέσων τους δεν θα σταλούν για μετάφραση. Για να τα συμπεριλάβετε, ενεργοποιήστε την επιλογή “Μετάφραση κειμένων βιβλιοθήκης πολυμέσων κατά τη μετάφραση περιεχομένου” στις ρυθμίσεις του WPML Media Translation."

#. translators: Heading of the admin notice about untranslated media texts.
#: classes/Notice/MediaTexts.php:122
msgid "Media texts are not being translated"
msgstr "Τα κείμενα πολυμέσων δεν μεταφράζονται"

#. translators: The placeholders are replaced by an HTML link pointing to the WPML Media settings page.
#: classes/Notice/MediaTexts.php:126
#, php-format
msgid "%1$sGo to Media Translation settings%2$s"
msgstr "%1$sΜετάβαση στις ρυθμίσεις μετάφρασης πολυμέσων%2$s"

#. translators: Heading of the admin notice on an ACF options page. Keep the bold tags around the WPML screen name; "Options page" is ACF's own name for that screen. Verb, imperative.
#: classes/Options/EditorHooks.php:502
msgid "Translate this Options page from the <b>Translation Dashboard</b>"
msgstr "Μεταφράστε αυτήν τη σελίδα επιλογών από τον <b>Πίνακα ελέγχου μετάφρασης</b>"

#. translators: Text in the notice on an ACF options page in a secondary language. %1$s: opening link tag, %2$s: closing link tag; the link opens WPML's Translation Dashboard.
#: classes/Options/EditorHooks.php:505
#, php-format
msgid "You no longer need to switch the admin language to translate options manually. Translate all your options from the %1$sTranslation Dashboard%2$s."
msgstr "Δεν χρειάζεται πλέον να αλλάζετε τη γλώσσα διαχείρισης για να μεταφράζετε τις επιλογές χειροκίνητα. Μεταφράστε όλες τις επιλογές σας από τον %1$sΠίνακα ελέγχου μετάφρασης%2$s."

#. translators: Tooltip of the link in that notice; it opens WPML's Translation Dashboard.
#: classes/Options/EditorHooks.php:507
msgid "Go to the Translation Dashboard"
msgstr "Μετάβαση στον πίνακα ελέγχου μετάφρασης"

#. translators: Text in the notice on an ACF options page in a secondary language. %1$s: opening link tag, %2$s: closing link tag; the link opens WPML's Translation Jobs list. "Edit Translation" is the tooltip of the pencil icon in that list: use the same words as WPML's own translation of that tooltip.
#: classes/Options/EditorHooks.php:512
#, php-format
msgid "To change a finished translation, go to %1$sTranslation Jobs%2$s and click on the Edit Translation icon."
msgstr "Για να αλλάξετε μια ολοκληρωμένη μετάφραση, μεταβείτε στις %1$sΕργασίες μετάφρασης%2$s και κάντε κλικ στο εικονίδιο Επεξεργασία μετάφρασης."

#. translators: Tooltip of the link in that notice; it opens WPML's Translation Jobs list.
#: classes/Options/EditorHooks.php:514
msgid "Go to Translation Jobs"
msgstr "Μετάβαση στις εργασίες μετάφρασης"

#. translators: 1: number of fields the form sent, 2: the max_input_vars limit
#: classes/Post/MaxInputVarsGuard.php:43
#, php-format
msgid "WPML blocked this save to prevent data loss. The form sent about %1$s fields, but the PHP max_input_vars limit on this server (%2$s) let fewer through. Saving now would permanently delete the fields that did not arrive, including repeater rows. Nothing was saved. Ask your host to raise max_input_vars above %1$s and save again."
msgstr "Το WPML απέκλεισε αυτήν την αποθήκευση για να αποτρέψει την απώλεια δεδομένων. Η φόρμα έστειλε περίπου %1$s πεδία, αλλά το όριο PHP max_input_vars σε αυτόν τον διακομιστή επέτρεψε λιγότερα (%2$s). Η αποθήκευση τώρα θα διέγραφε οριστικά τα πεδία που δεν έφτασαν, συμπεριλαμβανομένων των σειρών επαναλήπτη. Τίποτα δεν αποθηκεύτηκε. Ζητήστε από τον πάροχο φιλοξενίας σας να αυξήσει το max_input_vars πάνω από %1$s και αποθηκεύστε ξανά."

#. translators: Title of the error page shown when a field group has more fields than the server will accept in one save.
#: classes/Post/MaxInputVarsGuard.php:55
msgid "Save blocked to prevent data loss"
msgstr "Η αποθήκευση αποκλείστηκε για την αποφυγή απώλειας δεδομένων"

#. translators: %1$s: opening <a> tag, %2$s: closing </a> tag.
#: classes/Post/MixedFieldGroupModesHooks.php:119
#, php-format
msgid "You need to %1$stranslate this post manually%2$s because the field groups attached to it use different translation options:"
msgstr "Πρέπει να %1$sμεταφράσετε αυτήν την ανάρτηση χειροκίνητα%2$s επειδή οι ομάδες πεδίων που είναι συνδεδεμένες σε αυτήν χρησιμοποιούν διαφορετικές επιλογές μετάφρασης:"

#. translators: %d: number of additional field groups not listed.
#: classes/Post/MixedFieldGroupModesHooks.php:141
#, php-format
msgid "and %d more."
msgstr "και %d ακόμη."

#. translators: Link and button that open the ACF field-groups list, in the notice about field groups set up differently from one another. Verb phrase, imperative.
#: classes/Post/MixedFieldGroupModesHooks.php:144
#: classes/Post/MixedFieldGroupModesHooks.php:224
msgid "Show all field groups"
msgstr "Εμφάνιση όλων των ομάδων πεδίων"

#. translators: %d: number of additional field groups not listed.
#: classes/Post/MixedFieldGroupModesHooks.php:193
#, php-format
msgid "and %d more"
msgstr "και %d ακόμη"

#. translators: %s: comma-separated list of field groups with their translation options.
#: classes/Post/MixedFieldGroupModesHooks.php:198
#, php-format
msgid "You need to translate this post manually because the field groups attached to it use different translation options: %s."
msgstr "Πρέπει να μεταφράσετε αυτήν την ανάρτηση χειροκίνητα επειδή οι ομάδες πεδίων που είναι συνδεδεμένες σε αυτήν χρησιμοποιούν διαφορετικές επιλογές μετάφρασης: %s."

#. translators: %s: field group name.
#: classes/Post/MixedFieldGroupModesHooks.php:215
#, php-format
msgid "Edit %s"
msgstr "Επεξεργασία %s"

#. translators: Button in that notice; it opens the ACFML documentation. Verb phrase, imperative.
#: classes/Post/MixedFieldGroupModesHooks.php:231
msgid "Go to documentation"
msgstr "Μετάβαση στην τεκμηρίωση"

#. translators: Tooltip of a field locked in the WordPress editor of a translation.
#: classes/Post/NativeEditorTranslationHooks.php:210
msgid "This field value is copied from the default language and will be kept in sync across languages."
msgstr "Αυτή η τιμή πεδίου αντιγράφεται από την προεπιλεγμένη γλώσσα και θα διατηρείται σε συγχρονισμό σε όλες τις γλώσσες."

#. translators: Heading of the checkbox that keeps repeater rows in the same order across languages, in the post editor. Verb phrase, imperative.
#: classes/strategy/repeater-sync/CheckboxUI.php:20
msgid "Synchronise translations"
msgstr "Συγχρονισμός μεταφράσεων"

#. translators: Label of that checkbox; "repeater" and "flexible" are ACF field types.
#: classes/strategy/repeater-sync/CheckboxUI.php:26
msgid "Keep repeater and flexible sub-fields in the same order as the default language."
msgstr "Διατήρηση των υποπεδίων επαναλήπτη και ευέλικτου περιεχομένου στην ίδια σειρά με την προεπιλεγμένη γλώσσα."

#. translators: Title of the panel holding that checkbox in the post editor. "ACFML" is the plugin's short name and stays in English.
#: classes/strategy/repeater-sync/CheckboxUI.php:43
msgid "ACFML Synchronise translations"
msgstr "ACFML Συγχρονισμός μεταφράσεων"

#. translators: Title of the WPML tool that registers fields defined outside the database. "Local JSON" is ACF's own name for that storage. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:41
msgid "Translate ACF Local JSON and PHP-Registered Fields"
msgstr "Μετάφραση τοπικών πεδίων ACF καταχωρημένων μέσω JSON και PHP"

#. translators: %1$s, %2$s, %3$s and %4$s are placeholders for two <a> link tags.
#: classes/Tools/LocalUI.php:60
#, php-format
msgid "ACF allows you to %1$sregister fields via PHP%2$s or %3$ssave field settings as JSON files%4$s. You can also save post types, taxonomies, or options pages settings to JSON files."
msgstr "Το ACF σάς επιτρέπει να %1$sκαταχωρείτε πεδία μέσω PHP%2$s ή να %3$sαποθηκεύετε ρυθμίσεις πεδίων ως αρχεία JSON%4$s. Μπορείτε επίσης να αποθηκεύσετε ρυθμίσεις τύπων αναρτήσεων, ταξινομιών ή σελίδων επιλογών σε αρχεία JSON."

#. translators: Line under the tool's heading; "these items" are the field groups, post types, taxonomies and options pages defined in code or in acf-json files.
#: classes/Tools/LocalUI.php:69
msgid "Configure how ACF Multilingual handles translations for these items."
msgstr "Διαμορφώστε τον τρόπο με τον οποίο το ACF Multilingual χειρίζεται τις μεταφράσεις για αυτά τα στοιχεία."

#. translators: Heading of the first setting of that tool. Keep the bold tags around the name of the preference set. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:73
msgid "Sync <b>Translation Preferences</b> for Local Fields"
msgstr "Συγχρονισμός <b>προτιμήσεων μετάφρασης</b> για τοπικά πεδία"

#. translators: First option of that setting: leave the preferences of code-defined fields alone.
#: classes/Tools/LocalUI.php:79
msgid "Don’t sync translation preferences"
msgstr "Να μη συγχρονίζονται οι προτιμήσεις μετάφρασης"

#. translators: Second option of that setting: copy the preferences a single time. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:86
msgid "Sync once now"
msgstr "Συγχρονισμός μία φορά τώρα"

#. translators: Third option of that setting: copy the preferences on every page load. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:93
msgid "Sync on every request (may affect performance)"
msgstr "Συγχρονισμός σε κάθε αίτημα (ενδέχεται να επηρεάσει την απόδοση)"

#. translators: Heading of the second setting of the tool, about making field names translatable. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:100
msgid "Register Labels for Translation"
msgstr "Καταχώριση ετικετών για μετάφραση"

#. translators: Explanation under that heading. Keep "acf-json" in English: it is a folder name.
#: classes/Tools/LocalUI.php:104
msgid "Scans post types, taxonomies, options pages, and field groups stored in the \"acf-json\" directory, then registers their labels with WPML so you can translate them."
msgstr "Σαρώνει τύπους αναρτήσεων, ταξινομίες, σελίδες επιλογών και ομάδες πεδίων που είναι αποθηκευμένα στον κατάλογο “acf-json” και, στη συνέχεια, καταχωρεί τις ετικέτες τους στο WPML ώστε να μπορείτε να τις μεταφράσετε."

#. translators: First option of the label-registration setting: leave the names alone.
#: classes/Tools/LocalUI.php:113
msgid "Don’t register labels"
msgstr "Να μη γίνεται καταχώριση ετικετών"

#. translators: Second option of the label-registration setting: make the names translatable straight away. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:120
msgid "Register labels now"
msgstr "Καταχώριση ετικετών τώρα"

#. translators: Button that saves the tool's settings and runs it. Verb, imperative.
#: classes/Tools/LocalUI.php:130
msgid "Apply"
msgstr "Εφαρμογή"

#. translators: Confirmation shown after the tool ran with syncing switched off.
#: classes/Tools/LocalUI.php:159
msgid "The synchronization of translation preferences is disabled."
msgstr "Ο συγχρονισμός των προτιμήσεων μετάφρασης είναι απενεργοποιημένος."

#. translators: Confirmation shown after the tool copied the preferences once.
#: classes/Tools/LocalUI.php:164
msgid "Translation preferences synchronized."
msgstr "Οι προτιμήσεις μετάφρασης συγχρονίστηκαν."

#. translators: Confirmation shown after the tool ran with syncing switched on.
#: classes/Tools/LocalUI.php:169
msgid "The synchronization of translation preferences is enabled."
msgstr "Ο συγχρονισμός των προτιμήσεων μετάφρασης είναι ενεργοποιημένος."

#. translators: Item in the list of what the tool registered, joined with the others by "and". %s: how many field groups.
#: classes/Tools/LocalUI.php:235
#, php-format
msgid "%s group"
msgid_plural "%s groups"
msgstr[0] "%s ομάδα"
msgstr[1] "%s ομάδες"

#. translators: Item in the list of what the tool registered, joined with the others by "and". %s: how many post types.
#: classes/Tools/LocalUI.php:238
#, php-format
msgid "%s post type"
msgid_plural "%s post types"
msgstr[0] "%s τύπος ανάρτησης"
msgstr[1] "%s τύποι αναρτήσεων"

#. translators: Item in the list of what the tool registered, joined with the others by "and". %s: how many taxonomies.
#: classes/Tools/LocalUI.php:241
#, php-format
msgid "%s taxonomy"
msgid_plural "%s taxonomies"
msgstr[0] "%s ταξινομία"
msgstr[1] "%s ταξινομίες"

#. translators: Item in the list of what the tool registered, joined with the others by "and". %s: how many ACF options pages.
#: classes/Tools/LocalUI.php:244
#, php-format
msgid "%s options page"
msgid_plural "%s options pages"
msgstr[0] "%s σελίδα επιλογών"
msgstr[1] "%s σελίδες επιλογών"

#. translators: Result shown when the tool found nothing defined in code or in acf-json files.
#: classes/Tools/LocalUI.php:258
msgid "No local field groups, post types, taxonomies, or Options pages were found."
msgstr "Δεν βρέθηκαν τοπικές ομάδες πεδίων, τύποι αναρτήσεων, ταξινομίες ή σελίδες επιλογών."

#. translators: The word joining the only two items of a list, inside the sentence saying what the tool registered. Keep the space on each side.
#: classes/Tools/LocalUI.php:270
msgctxt "Used between elements of a two elements list"
msgid " and "
msgstr " και "

#. translators: The comma and word placed before the last item of a list of three or more, inside the sentence saying what the tool registered. Keep the trailing space.
#: classes/Tools/LocalUI.php:276
msgctxt "Used before the last element of a three or more elements list"
msgid ", and "
msgstr ", και "

#. translators: %s: List of registered labels.
#: classes/Tools/LocalUI.php:281
#, php-format
msgid "Successfully registered labels for %s."
msgstr "Επιτυχής καταχώριση ετικετών για %s."

#. translators: %1$s and %2$s are placeholders for bold tags.
#: classes/TranslationDataMetaboxHooks.php:69
#, php-format
msgid "%1$sChange translation settings%2$s"
msgstr "%1$sΑλλαγή ρυθμίσεων μετάφρασης%2$s"

#. translators: %1$s and %2$s are placeholders for link tags.
#: classes/TranslationDataMetaboxHooks.php:86
#, php-format
msgid "%1$sTranslate labels%2$s"
msgstr "%1$sΜετάφραση ετικετών%2$s"

#. translators: Status shown in the Multilingual Setup panel for a post type or taxonomy WPML does not translate. Adjective.
#: classes/TranslationDataTrait.php:44
msgid "Not translatable"
msgstr "Μη μεταφράσιμο"

#. translators: Status shown in the Multilingual Setup panel for a post type or taxonomy WPML translates. Adjective.
#: classes/TranslationDataTrait.php:48
msgid "Translatable"
msgstr "Μεταφράσιμο"

#. translators: Second half of a status line in the Multilingual Setup panel; it follows "Translatable" and a dash. Lower case for that reason.
#: classes/TranslationDataTrait.php:62
msgid "only show translated items"
msgstr "εμφάνιση μόνο μεταφρασμένων στοιχείων"

#. translators: Second half of a status line in the Multilingual Setup panel; it follows "Translatable" and a dash. Lower case for that reason.
#: classes/TranslationDataTrait.php:65
msgid "use translation if available or fallback to default language"
msgstr "χρήση μετάφρασης εάν είναι διαθέσιμη ή εναλλακτική στην προεπιλεγμένη γλώσσα"

#. translators: %1$s: ACF field group name.
#: classes/TranslationEditor/DisableHooks.php:46
#, php-format
msgid "This content must be translated manually due to the translation option you selected for the \"%1$s\" field group."
msgstr "Αυτό το περιεχόμενο πρέπει να μεταφραστεί χειροκίνητα λόγω της επιλογής μετάφρασης που επιλέξατε για την ομάδα πεδίων “%1$s”."
