#. translators: %d: number of additional field groups not listed.
#: classes/Post/MixedFieldGroupModesHooks.php:141
#, php-format
msgid "and %d more."
msgstr "та ще %d."

#. translators: Link and button that open the ACF field-groups list, in the notice about field groups set up differently from one another. Verb phrase, imperative.
#: classes/Post/MixedFieldGroupModesHooks.php:144
#: classes/Post/MixedFieldGroupModesHooks.php:224
msgid "Show all field groups"
msgstr "Показати всі групи полів"

#. translators: %d: number of additional field groups not listed.
#: classes/Post/MixedFieldGroupModesHooks.php:193
#, php-format
msgid "and %d more"
msgstr "та ще %d"

#. translators: %s: comma-separated list of field groups with their translation options.
#: classes/Post/MixedFieldGroupModesHooks.php:198
#, php-format
msgid "You need to translate this post manually because the field groups attached to it use different translation options: %s."
msgstr "Вам потрібно перекласти цей запис вручну, оскільки групи полів, прикріплені до нього, використовують різні параметри перекладу: %s."

#. translators: %s: field group name.
#: classes/Post/MixedFieldGroupModesHooks.php:215
#, php-format
msgid "Edit %s"
msgstr "Редагувати %s"

#. translators: Button in that notice; it opens the ACFML documentation. Verb phrase, imperative.
#: classes/Post/MixedFieldGroupModesHooks.php:231
msgid "Go to documentation"
msgstr "Перейти до документації"

#. translators: Tooltip of a field locked in the WordPress editor of a translation.
#: classes/Post/NativeEditorTranslationHooks.php:210
msgid "This field value is copied from the default language and will be kept in sync across languages."
msgstr "Значення цього поля копіюється з мови за замовчуванням і буде синхронізуватися між мовами."

#. translators: Heading of the checkbox that keeps repeater rows in the same order across languages, in the post editor. Verb phrase, imperative.
#: classes/strategy/repeater-sync/CheckboxUI.php:20
msgid "Synchronise translations"
msgstr "Синхронізувати переклади"

#. translators: Label of that checkbox; "repeater" and "flexible" are ACF field types.
#: classes/strategy/repeater-sync/CheckboxUI.php:26
msgid "Keep repeater and flexible sub-fields in the same order as the default language."
msgstr "Зберігати підполя повторювача та гнучкого вмісту в тому самому порядку, що й у мові за замовчуванням."

#. translators: Title of the panel holding that checkbox in the post editor. "ACFML" is the plugin's short name and stays in English.
#: classes/strategy/repeater-sync/CheckboxUI.php:43
msgid "ACFML Synchronise translations"
msgstr "ACFML Синхронізувати переклади"

#. translators: Title of the WPML tool that registers fields defined outside the database. "Local JSON" is ACF's own name for that storage. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:41
msgid "Translate ACF Local JSON and PHP-Registered Fields"
msgstr "Перекласти локальні поля ACF, зареєстровані через JSON та PHP"

#. translators: %1$s, %2$s, %3$s and %4$s are placeholders for two <a> link tags.
#: classes/Tools/LocalUI.php:60
#, php-format
msgid "ACF allows you to %1$sregister fields via PHP%2$s or %3$ssave field settings as JSON files%4$s. You can also save post types, taxonomies, or options pages settings to JSON files."
msgstr "ACF дозволяє %1$sреєструвати поля через PHP%2$s або %3$sзберігати налаштування полів як файли JSON%4$s. Ви також можете зберігати налаштування типів записів, таксономій або сторінок опцій у файлах JSON."

#. translators: Line under the tool's heading; "these items" are the field groups, post types, taxonomies and options pages defined in code or in acf-json files.
#: classes/Tools/LocalUI.php:69
msgid "Configure how ACF Multilingual handles translations for these items."
msgstr "Налаштуйте, як ACF Multilingual обробляє переклади для цих елементів."

#. translators: Heading of the first setting of that tool. Keep the bold tags around the name of the preference set. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:73
msgid "Sync <b>Translation Preferences</b> for Local Fields"
msgstr "Синхронізувати <b>налаштування перекладу</b> для локальних полів"

#. translators: First option of that setting: leave the preferences of code-defined fields alone.
#: classes/Tools/LocalUI.php:79
msgid "Don’t sync translation preferences"
msgstr "Не синхронізувати налаштування перекладу"

#. translators: Second option of that setting: copy the preferences a single time. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:86
msgid "Sync once now"
msgstr "Синхронізувати один раз зараз"

#. translators: Third option of that setting: copy the preferences on every page load. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:93
msgid "Sync on every request (may affect performance)"
msgstr "Синхронізувати при кожному запиті (може вплинути на продуктивність)"

#. translators: Heading of the second setting of the tool, about making field names translatable. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:100
msgid "Register Labels for Translation"
msgstr "Зареєструвати мітки для перекладу"

#. translators: Explanation under that heading. Keep "acf-json" in English: it is a folder name.
#: classes/Tools/LocalUI.php:104
msgid "Scans post types, taxonomies, options pages, and field groups stored in the \"acf-json\" directory, then registers their labels with WPML so you can translate them."
msgstr "Сканує типи записів, таксономії, сторінки опцій та групи полів, що зберігаються в каталозі «acf-json», а потім реєструє їхні мітки у WPML, щоб ви могли їх перекласти."

#. translators: First option of the label-registration setting: leave the names alone.
#: classes/Tools/LocalUI.php:113
msgid "Don’t register labels"
msgstr "Не реєструвати мітки"

#. translators: Second option of the label-registration setting: make the names translatable straight away. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:120
msgid "Register labels now"
msgstr "Зареєструвати мітки зараз"

#. translators: Button that saves the tool's settings and runs it. Verb, imperative.
#: classes/Tools/LocalUI.php:130
msgid "Apply"
msgstr "Застосувати"

#. translators: Confirmation shown after the tool ran with syncing switched off.
#: classes/Tools/LocalUI.php:159
msgid "The synchronization of translation preferences is disabled."
msgstr "Синхронізацію налаштувань перекладу вимкнено."

#. translators: Confirmation shown after the tool copied the preferences once.
#: classes/Tools/LocalUI.php:164
msgid "Translation preferences synchronized."
msgstr "Налаштування перекладу синхронізовано."

#. translators: Confirmation shown after the tool ran with syncing switched on.
#: classes/Tools/LocalUI.php:169
msgid "The synchronization of translation preferences is enabled."
msgstr "Синхронізацію налаштувань перекладу увімкнено."

