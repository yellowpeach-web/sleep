#: classes/FieldGroup/UIHooks.php:384
msgid "Not set"
msgstr "Nicht festgelegt"

#. translators: Line in that dialog when no translated post uses the field group.
#: classes/FieldGroup/UIHooks.php:389
msgid "No posts with translations use this field group yet, so nothing has to be sent again."
msgstr "Noch keine Beiträge mit Übersetzungen verwenden diese Feldgruppe, daher muss nichts erneut gesendet werden."

#. translators: Line in that dialog when no translated category, tag or other term uses the field group.
#: classes/FieldGroup/UIHooks.php:391
msgid "No terms with translations use this field group yet, so nothing has to be sent again."
msgstr "Noch keine Begriffe mit Übersetzungen verwenden diese Feldgruppe, daher muss nichts erneut gesendet werden."

#. translators: Line in that dialog when neither a translated post nor a translated term uses the field group.
#: classes/FieldGroup/UIHooks.php:393
msgid "No posts or terms with translations use this field group yet, so nothing has to be sent again."
msgstr "Noch keine Beiträge oder Begriffe mit Übersetzungen verwenden diese Feldgruppe, daher muss nichts erneut gesendet werden."

#. translators: Label of the option that leaves existing translations alone. Verb phrase, imperative.
#: classes/FieldGroup/UIHooks.php:395
msgid "Only apply to new translations"
msgstr "Nur auf neue Übersetzungen anwenden"

#. translators: Shown in that dialog while the affected posts are being counted. Keep the three dots.
#: classes/FieldGroup/UIHooks.php:397
msgid "Checking how much content this affects..."
msgstr "Prüfe, wie viel Inhalt davon betroffen ist..."

#. translators: Button that confirms the dialog and saves the field group. Verb phrase, imperative.
#: classes/FieldGroup/UIHooks.php:401
msgid "Save changes"
msgstr "Änderungen speichern"

#. translators: Button that closes the dialog without saving the field group.
#: classes/FieldGroup/UIHooks.php:403
msgid "No, go back"
msgstr "Nein, zurück"

#. translators: Line in that dialog about the posts that already have translations; "them" are those posts.
#: classes/FieldGroup/UIHooks.php:415
msgid "Updating them sends them for translation again, which may use translation words."
msgstr "Das Aktualisieren sendet sie erneut zur Übersetzung, was Übersetzungswörter verbrauchen kann."

#. translators: Line in that dialog about the posts that already have translations, when WPML does not translate content automatically; "them" and "their" are those posts.
#: classes/FieldGroup/UIHooks.php:419
msgid "Updating them marks their translations as needing an update. WPML does not send them for translation. You can send them from the Translation Dashboard."
msgstr "Wenn Sie diese aktualisieren, werden ihre Übersetzungen als aktualisierungsbedürftig markiert. WPML sendet sie nicht zur Übersetzung. Sie können sie über das Übersetzungs-Dashboard senden."

#. translators: %d is the number of fields in the field group.
#: classes/FieldGroup/UIHooks.php:450
#: classes/FieldGroup/UIHooks.php:459
#, php-format
msgid "Switching the setup applies the recommended value to the %d field in this group."
msgid_plural "Switching the setup applies the recommended value to all %d fields in this group."
msgstr[0] "Das Umschalten der Einrichtung wendet den empfohlenen Wert auf das %d Feld in dieser Gruppe an."
msgstr[1] "Das Umschalten der Einrichtung wendet den empfohlenen Wert auf alle %d Felder in dieser Gruppe an."

#. translators: %d is the number of posts that already have translations.
#: classes/FieldGroup/UIHooks.php:468
#: classes/FieldGroup/UIHooks.php:477
#, php-format
msgid "%d post already has translations that used the old settings."
msgid_plural "%d posts already have translations that used the old settings."
msgstr[0] "%d Beitrag hat bereits Übersetzungen, die die alten Einstellungen verwendeten."
msgstr[1] "%d Beiträge haben bereits Übersetzungen, die die alten Einstellungen verwendeten."

#. translators: %d is the number of terms that already have translations.
#: classes/FieldGroup/UIHooks.php:487
#: classes/FieldGroup/UIHooks.php:496
#, php-format
msgid "%d term already has translations that used the old settings."
msgid_plural "%d terms already have translations that used the old settings."
msgstr[0] "%d Begriff hat bereits Übersetzungen, die die alten Einstellungen verwendeten."
msgstr[1] "%d Begriffe haben bereits Übersetzungen, die die alten Einstellungen verwendeten."

#. translators: %d is the number of posts using this field group.
#: classes/FieldGroup/UIHooks.php:505
#: classes/FieldGroup/UIHooks.php:514
#, php-format
msgid "%d post uses this field group."
msgid_plural "%d posts use this field group."
msgstr[0] "%d Beitrag verwendet diese Feldgruppe."
msgstr[1] "%d Beiträge verwenden diese Feldgruppe."

#. translators: %d is the number of posts with translations that have their own content in each language.
#: classes/FieldGroup/UIHooks.php:523
#: classes/FieldGroup/UIHooks.php:532
#, php-format
msgid "%d post is translated by hand, so WPML does not send it for translation."
msgid_plural "%d posts are translated by hand, so WPML does not send them for translation."
msgstr[0] "%d Beitrag wird manuell übersetzt, daher sendet WPML ihn nicht zur Übersetzung."
msgstr[1] "%d Beiträge werden manuell übersetzt, daher sendet WPML sie nicht zur Übersetzung."

#. translators: %d is the number of posts that already have translations.
#: classes/FieldGroup/UIHooks.php:541
#: classes/FieldGroup/UIHooks.php:550
#, php-format
msgid "Also update the %d existing post"
msgid_plural "Also update the %d existing posts"
msgstr[0] "Auch den %d bestehenden Beitrag aktualisieren"
msgstr[1] "Auch die %d bestehenden Beiträge aktualisieren"

#. translators: %d is the number of terms that already have translations.
#: classes/FieldGroup/UIHooks.php:559
#: classes/FieldGroup/UIHooks.php:568
#, php-format
msgid "Also update the %d existing term"
msgid_plural "Also update the %d existing terms"
msgstr[0] "Aktualisieren Sie auch den %d bestehenden Begriff"
msgstr[1] "Aktualisieren Sie auch die %d bestehenden Begriffe"

#. translators: %1$d is a number of posts, %2$d a number of terms.
#: classes/FieldGroup/UIHooks.php:576
#, php-format
msgid "Also update the %1$d existing posts and %2$d terms"
msgstr "Aktualisieren Sie auch die %1$d bestehenden Beiträge und %2$d Begriffe"

#. translators: %1$d is a number of posts, %2$d a number of terms.
#: classes/FieldGroup/UIHooks.php:578
#, php-format
msgid "Also update the %1$d existing post and %2$d terms"
msgstr "Aktualisieren Sie auch den %1$d bestehenden Beitrag und %2$d Begriffe"

#. translators: %1$d is a number of posts, %2$d a number of terms.
#: classes/FieldGroup/UIHooks.php:580
#, php-format
msgid "Also update the %1$d existing posts and %2$d term"
msgstr "Aktualisieren Sie auch die %1$d bestehenden Beiträge und den %2$d Begriff"

#. translators: %1$d is a number of posts, %2$d a number of terms.
#: classes/FieldGroup/UIHooks.php:582
#, php-format
msgid "Also update the %1$d existing post and %2$d term"
msgstr "Aktualisieren Sie auch den %1$d bestehenden Beitrag und den %2$d Begriff"

#. translators: First sentence of the notice on a field group attached to an ACF options page. "Options page" is ACF's own name for that screen.
#: classes/FieldGroup/UIHooks.php:598
msgid "This field group is shown on an Options page."
msgstr "Diese Feldgruppe wird auf einer Optionen-Seite angezeigt."

#. translators: Second sentence of that notice; "That" is the content on an options page.
#: classes/FieldGroup/UIHooks.php:600
msgid "That is usually site-wide content like your header, footer, or global blocks."
msgstr "Das sind normalerweise website-weite Inhalte wie Ihr Header, Footer oder globale Blöcke."

#. translators: %1$s and %2$s will wrap the string in a <a> link html tag
#: classes/FieldGroup/UIHooks.php:603
#, php-format
msgid "To translate that content, use the %1$sWPML Translation Dashboard%2$s."
msgstr "Um diesen Inhalt zu übersetzen, verwenden Sie das %1$sWPML-Übersetzungs-Dashboard%2$s."

#. translators: Last sentence of that notice; "the options below" are the translation options of the panel.
#: classes/FieldGroup/UIHooks.php:608
msgid "The options below still decide how each field behaves: translated, copied to every language, or kept separately per language."
msgstr "Die unten stehenden Optionen entscheiden weiterhin darüber, wie sich jedes Feld verhält: übersetzt, in jede Sprache kopiert oder separat pro Sprache beibehalten."

#. translators: First sentence of the notice on a field group used both on an ACF options page and elsewhere.
#: classes/FieldGroup/UIHooks.php:610
msgid "This field group also appears on an Options page."
msgstr "Diese Feldgruppe erscheint auch auf einer Optionen-Seite."

#. translators: %1$s and %2$s will wrap the string in a <a> link html tag
#: classes/FieldGroup/UIHooks.php:613
#, php-format
msgid "That content is translated in the %1$sWPML Translation Dashboard%2$s, and the option you choose here decides how each of its fields behaves."
msgstr "Dieser Inhalt wird im %1$sWPML-Übersetzungs-Dashboard%2$s übersetzt, und die Option, die Sie hier wählen, entscheidet darüber, wie sich jedes seiner Felder verhält."

#. translators: Name of the WPML screen that decides which post types are translated, used inside the panel that links to it.
#: classes/Helper/Cpt.php:75
msgid "Post Type Translation"
msgstr "Beitragstyp-Übersetzung"

#. translators: Row label in the Multilingual Setup panel, saying how the names of a post type, taxonomy or options page are translated.
#: classes/Helper/Cpt.php:83
#: classes/Helper/OptionsPage.php:82
#: classes/Helper/Taxonomy.php:83
msgid "Labels Translation"
msgstr "Beschriftungs-Übersetzung"

#. translators: Name of the WPML screen that decides which taxonomies are translated, used inside the panel that links to it.
#: classes/Helper/Taxonomy.php:75
msgid "Taxonomy Translation"
msgstr "Taxonomie-Übersetzung"

#. translators: Heading of the admin notice shown after the plugin is switched on. Keep the bold tags around the panel's name. Verb phrase, imperative.
#: classes/Notice/ActivationNotice.php:71
msgid "Finish the ACF <b>Multilingual Setup</b>"
msgstr "Schließen Sie die ACF-<b>Einrichtung für Mehrsprachigkeit</b> ab"

#. translators: Body of that admin notice; "Field Group" is ACF's own name for the screen.
#: classes/Notice/ActivationNotice.php:73
msgid "Before you can start translating, you need to edit each ACF Field Group to set a translation option for the fields inside it."
msgstr "Bevor Sie mit dem Übersetzen beginnen können, müssen Sie jede ACF-Feldgruppe bearbeiten, um eine Übersetzungseinstellung für die darin enthaltenen Felder festzulegen."

#. translators: The placeholders are replaced by an HTML link pointing to the documentation.
#: classes/Notice/ActivationNotice.php:76
#: classes/Notice/FieldGroupModes.php:61
#, php-format
msgid "Read more about %1$show to translate your ACF custom fields%2$s"
msgstr "Lesen Sie mehr darüber, %1$swie Sie Ihre eigenen ACF-Felder übersetzen%2$s"

#. translators: The placeholders are replaced by an HTML link pointing to field groups list.
#: classes/Notice/ActivationNotice.php:83
#, php-format
msgid "%1$sSet translation options%2$s"
msgstr "%1$sÜbersetzungseinstellungen festlegen%2$s"

#. translators: Heading of the admin notice inviting the site owner to set a translation option on each field group.
#: classes/Notice/FieldGroupModes.php:56
msgid "Let's Start Translating!"
msgstr "Lassen Sie uns mit dem Übersetzen beginnen!"

#. translators: Body of that admin notice; "Field Group" is ACF's own name for the screen.
#: classes/Notice/FieldGroupModes.php:58
msgid "Edit each Field Group to select a translation option for the fields inside it. If you don't set a translation option, you will not be able to translate your fields."
msgstr "Bearbeiten Sie jede Feldgruppe, um eine Übersetzungseinstellung für die darin enthaltenen Felder auszuwählen. Wenn Sie keine Übersetzungseinstellung festlegen, können Sie Ihre Felder nicht übersetzen."

#. translators: %s is the title of the field group being saved.
#: classes/Notice/FieldNameCollisions.php:102
#, php-format
msgid "A field in \"%s\" has the same name as a field in another field group. WPML stores translation preferences by field name, so two fields that share a name cannot be set differently."
msgstr "Ein Feld in „%s“ hat denselben Namen wie ein Feld in einer anderen Feldgruppe. WPML speichert Übersetzungseinstellungen nach Feldname, daher können zwei Felder mit demselben Namen nicht unterschiedlich eingestellt werden."

#. translators: %s is the title of the field group being saved.
#: classes/Notice/FieldNameCollisions.php:104
#, php-format
msgid "Some fields in \"%s\" have the same name as fields in other field groups. WPML stores translation preferences by field name, so fields that share a name cannot be set differently."
msgstr "Einige Felder in „%s“ haben denselben Namen wie Felder in anderen Feldgruppen. WPML speichert Übersetzungseinstellungen nach Feldname, daher können Felder mit demselben Namen nicht unterschiedlich eingestellt werden."

#. translators: Heading of the admin notice about two fields in different groups sharing a name; "here" is the field group being edited.
#: classes/Notice/FieldNameCollisions.php:107
msgid "What you set here may not be what your visitors get"
msgstr "Was Sie hier einstellen, entspricht eventuell nicht dem, was Ihre Besucher sehen"

#. translators: %1$s is a field name, %2$s is the title of another field group.
#: classes/Notice/FieldNameCollisions.php:127
#, php-format
msgid "The field %1$s also exists in \"%2$s\". Rename this field to give it a translation setting of its own."
msgstr "Das Feld %1$s existiert auch in „%2$s“. Benennen Sie dieses Feld um, um ihm eine eigene Übersetzungseinstellung zu geben."

#. translators: Link at the end of a line in that notice; it opens the other field group. Verb phrase, imperative.
#: classes/Notice/FieldNameCollisions.php:135
msgid "See both fields"
msgstr "Beide Felder anzeigen"

#. translators: Button in the admin notice about untranslated media texts; it opens WPML's Media Translation settings. Verb phrase, imperative.
#: classes/Notice/MediaTexts.php:57
msgid "Go to Media Translation settings"
msgstr "Zu den Medienübersetzungs-Einstellungen gehen"

#. translators: Body of the admin notice about untranslated media texts. The quoted text is the name of a WPML setting and is translated the same way there.
#: classes/Notice/MediaTexts.php:110
msgid "This content has ACF image, gallery, or file fields, but the alt text, caption, and title of their media will not be sent for translation. To include them, turn on \"Translate Media Library texts when translating content\" in WPML Media Translation settings."
msgstr "Dieser Inhalt enthält ACF-Bild-, Galerie- oder Dateifelder, aber der Alt-Text, die Beschriftung und der Titel ihrer Medien werden nicht zur Übersetzung gesendet. Um diese einzuschließen, aktivieren Sie „Texte der Medienbibliothek beim Übersetzen von Inhalten übersetzen“ in den Einstellungen von WPML Media Translation."

#. translators: Heading of the admin notice about untranslated media texts.
#: classes/Notice/MediaTexts.php:122
msgid "Media texts are not being translated"
msgstr "Medientexte werden nicht übersetzt"

#. translators: The placeholders are replaced by an HTML link pointing to the WPML Media settings page.
#: classes/Notice/MediaTexts.php:126
#, php-format
msgid "%1$sGo to Media Translation settings%2$s"
msgstr "%1$sZu den Medienübersetzungs-Einstellungen gehen%2$s"

#. translators: Heading of the admin notice on an ACF options page. Keep the bold tags around the WPML screen name; "Options page" is ACF's own name for that screen. Verb, imperative.
#: classes/Options/EditorHooks.php:502
msgid "Translate this Options page from the <b>Translation Dashboard</b>"
msgstr "Übersetzen Sie diese Optionen-Seite über das <b>Übersetzungs-Dashboard</b>"

#. translators: Text in the notice on an ACF options page in a secondary language. %1$s: opening link tag, %2$s: closing link tag; the link opens WPML's Translation Dashboard.
#: classes/Options/EditorHooks.php:505
#, php-format
msgid "You no longer need to switch the admin language to translate options manually. Translate all your options from the %1$sTranslation Dashboard%2$s."
msgstr "Sie müssen die Admin-Sprache nicht mehr wechseln, um Optionen manuell zu übersetzen. Übersetzen Sie alle Ihre Optionen über das %1$sÜbersetzungs-Dashboard%2$s."

#. translators: Tooltip of the link in that notice; it opens WPML's Translation Dashboard.
#: classes/Options/EditorHooks.php:507
msgid "Go to the Translation Dashboard"
msgstr "Zum Übersetzungs-Dashboard gehen"

#. translators: Text in the notice on an ACF options page in a secondary language. %1$s: opening link tag, %2$s: closing link tag; the link opens WPML's Translation Jobs list. "Edit Translation" is the tooltip of the pencil icon in that list: use the same words as WPML's own translation of that tooltip.
#: classes/Options/EditorHooks.php:512
#, php-format
msgid "To change a finished translation, go to %1$sTranslation Jobs%2$s and click on the Edit Translation icon."
msgstr "Um eine abgeschlossene Übersetzung zu ändern, gehen Sie zu %1$sÜbersetzungsaufträge%2$s und klicken Sie auf das Symbol „Übersetzung bearbeiten“."

#. translators: Tooltip of the link in that notice; it opens WPML's Translation Jobs list.
#: classes/Options/EditorHooks.php:514
msgid "Go to Translation Jobs"
msgstr "Gehen Sie zu Übersetzungsaufträge"

#. translators: 1: number of fields the form sent, 2: the max_input_vars limit
#: classes/Post/MaxInputVarsGuard.php:43
#, php-format
msgid "WPML blocked this save to prevent data loss. The form sent about %1$s fields, but the PHP max_input_vars limit on this server (%2$s) let fewer through. Saving now would permanently delete the fields that did not arrive, including repeater rows. Nothing was saved. Ask your host to raise max_input_vars above %1$s and save again."
msgstr "WPML hat diesen Speichervorgang blockiert, um Datenverlust zu vermeiden. Das Formular hat etwa %1$s Felder gesendet, aber das PHP-Limit max_input_vars auf diesem Server hat nur (%2$s) durchgelassen. Ein Speichern würde die nicht angekommenen Felder, einschließlich Repeater-Zeilen, dauerhaft löschen. Es wurde nichts gespeichert. Bitten Sie Ihren Hoster, max_input_vars auf über %1$s zu erhöhen und speichern Sie erneut."

#. translators: Title of the error page shown when a field group has more fields than the server will accept in one save.
#: classes/Post/MaxInputVarsGuard.php:55
msgid "Save blocked to prevent data loss"
msgstr "Speichern blockiert, um Datenverlust zu vermeiden"

#. translators: %1$s: opening <a> tag, %2$s: closing </a> tag.
#: classes/Post/MixedFieldGroupModesHooks.php:119
#, php-format
msgid "You need to %1$stranslate this post manually%2$s because the field groups attached to it use different translation options:"
msgstr "Sie müssen %1$sdiesen Beitrag manuell übersetzen%2$s, da die damit verknüpften Feldgruppen unterschiedliche Übersetzungseinstellungen verwenden:"

#. translators: %d: number of additional field groups not listed.
#: classes/Post/MixedFieldGroupModesHooks.php:141
#, php-format
msgid "and %d more."
msgstr "und %d weitere."

#. translators: Link and button that open the ACF field-groups list, in the notice about field groups set up differently from one another. Verb phrase, imperative.
#: classes/Post/MixedFieldGroupModesHooks.php:144
#: classes/Post/MixedFieldGroupModesHooks.php:224
msgid "Show all field groups"
msgstr "Alle Feldgruppen anzeigen"

#. translators: %d: number of additional field groups not listed.
#: classes/Post/MixedFieldGroupModesHooks.php:193
#, php-format
msgid "and %d more"
msgstr "und %d weitere"

#. translators: %s: comma-separated list of field groups with their translation options.
#: classes/Post/MixedFieldGroupModesHooks.php:198
#, php-format
msgid "You need to translate this post manually because the field groups attached to it use different translation options: %s."
msgstr "Sie müssen diesen Beitrag manuell übersetzen, da die damit verknüpften Feldgruppen unterschiedliche Übersetzungseinstellungen verwenden: %s."

#. translators: %s: field group name.
#: classes/Post/MixedFieldGroupModesHooks.php:215
#, php-format
msgid "Edit %s"
msgstr "%s bearbeiten"

#. translators: Button in that notice; it opens the ACFML documentation. Verb phrase, imperative.
#: classes/Post/MixedFieldGroupModesHooks.php:231
msgid "Go to documentation"
msgstr "Zur Dokumentation gehen"

#. translators: Tooltip of a field locked in the WordPress editor of a translation.
#: classes/Post/NativeEditorTranslationHooks.php:210
msgid "This field value is copied from the default language and will be kept in sync across languages."
msgstr "Dieser Feldwert wird aus der Standardsprache kopiert und über alle Sprachen hinweg synchronisiert."

#. translators: Heading of the checkbox that keeps repeater rows in the same order across languages, in the post editor. Verb phrase, imperative.
#: classes/strategy/repeater-sync/CheckboxUI.php:20
msgid "Synchronise translations"
msgstr "Übersetzungen synchronisieren"

#. translators: Label of that checkbox; "repeater" and "flexible" are ACF field types.
#: classes/strategy/repeater-sync/CheckboxUI.php:26
msgid "Keep repeater and flexible sub-fields in the same order as the default language."
msgstr "Repeater- und flexible Unterfelder in der gleichen Reihenfolge wie in der Standardsprache halten."

#. translators: Title of the panel holding that checkbox in the post editor. "ACFML" is the plugin's short name and stays in English.
#: classes/strategy/repeater-sync/CheckboxUI.php:43
msgid "ACFML Synchronise translations"
msgstr "ACFML Übersetzungen synchronisieren"

#. translators: Title of the WPML tool that registers fields defined outside the database. "Local JSON" is ACF's own name for that storage. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:41
msgid "Translate ACF Local JSON and PHP-Registered Fields"
msgstr "Lokale ACF-JSON- und PHP-registrierte Felder übersetzen"

#. translators: %1$s, %2$s, %3$s and %4$s are placeholders for two <a> link tags.
#: classes/Tools/LocalUI.php:60
#, php-format
msgid "ACF allows you to %1$sregister fields via PHP%2$s or %3$ssave field settings as JSON files%4$s. You can also save post types, taxonomies, or options pages settings to JSON files."
msgstr "ACF ermöglicht es Ihnen, %1$sFelder über PHP zu registrieren%2$s oder %3$sFeldeinstellungen als JSON-Dateien zu speichern%4$s. Sie können auch Einstellungen für Beitragstypen, Taxonomien oder Optionen-Seiten in JSON-Dateien speichern."

#. translators: Line under the tool's heading; "these items" are the field groups, post types, taxonomies and options pages defined in code or in acf-json files.
#: classes/Tools/LocalUI.php:69
msgid "Configure how ACF Multilingual handles translations for these items."
msgstr "Konfigurieren Sie, wie ACF Multilingual Übersetzungen für diese Elemente handhabt."

#. translators: Heading of the first setting of that tool. Keep the bold tags around the name of the preference set. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:73
msgid "Sync <b>Translation Preferences</b> for Local Fields"
msgstr "<b>Übersetzungseinstellungen</b> für lokale Felder synchronisieren"

#. translators: First option of that setting: leave the preferences of code-defined fields alone.
#: classes/Tools/LocalUI.php:79
msgid "Don’t sync translation preferences"
msgstr "Übersetzungseinstellungen nicht synchronisieren"

#. translators: Second option of that setting: copy the preferences a single time. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:86
msgid "Sync once now"
msgstr "Jetzt einmalig synchronisieren"

#. translators: Third option of that setting: copy the preferences on every page load. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:93
msgid "Sync on every request (may affect performance)"
msgstr "Bei jeder Anfrage synchronisieren (kann die Leistung beeinträchtigen)"

#. translators: Heading of the second setting of the tool, about making field names translatable. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:100
msgid "Register Labels for Translation"
msgstr "Beschriftungen für die Übersetzung registrieren"

#. translators: Explanation under that heading. Keep "acf-json" in English: it is a folder name.
#: classes/Tools/LocalUI.php:104
msgid "Scans post types, taxonomies, options pages, and field groups stored in the \"acf-json\" directory, then registers their labels with WPML so you can translate them."
msgstr "Durchsucht Beitragstypen, Taxonomien, Optionen-Seiten und Feldgruppen, die im Verzeichnis „acf-json“ gespeichert sind, und registriert deren Beschriftungen bei WPML, damit Sie diese übersetzen können."

#. translators: First option of the label-registration setting: leave the names alone.
#: classes/Tools/LocalUI.php:113
msgid "Don’t register labels"
msgstr "Beschriftungen nicht registrieren"

#. translators: Second option of the label-registration setting: make the names translatable straight away. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:120
msgid "Register labels now"
msgstr "Beschriftungen jetzt registrieren"

