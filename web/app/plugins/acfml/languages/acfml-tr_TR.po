#: classes/Tools/LocalUI.php:41
msgid "Translate ACF Local JSON and PHP-Registered Fields"
msgstr "ACF yerel JSON ve PHP ile kaydedilmiş alanları çevir"

#. translators: %1$s, %2$s, %3$s and %4$s are placeholders for two <a> link tags.
#: classes/Tools/LocalUI.php:60
#, php-format
msgid "ACF allows you to %1$sregister fields via PHP%2$s or %3$ssave field settings as JSON files%4$s. You can also save post types, taxonomies, or options pages settings to JSON files."
msgstr "ACF, %1$sPHP aracılığıyla alan kaydetmenize%2$s veya %3$salan ayarlarını JSON dosyaları olarak kaydetmenize%4$s olanak tanır. Ayrıca yazı türlerini, taksonomileri veya seçenekler sayfaları ayarlarını JSON dosyalarına kaydedebilirsiniz."

#. translators: Line under the tool's heading; "these items" are the field groups, post types, taxonomies and options pages defined in code or in acf-json files.
#: classes/Tools/LocalUI.php:69
msgid "Configure how ACF Multilingual handles translations for these items."
msgstr "ACF Multilingual’ın bu öğeler için çevirileri nasıl işleyeceğini yapılandırın."

#. translators: Heading of the first setting of that tool. Keep the bold tags around the name of the preference set. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:73
msgid "Sync <b>Translation Preferences</b> for Local Fields"
msgstr "Yerel alanlar için <b>çeviri tercihlerini</b> senkronize et"

#. translators: First option of that setting: leave the preferences of code-defined fields alone.
#: classes/Tools/LocalUI.php:79
msgid "Don’t sync translation preferences"
msgstr "Çeviri tercihlerini senkronize etme"

#. translators: Second option of that setting: copy the preferences a single time. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:86
msgid "Sync once now"
msgstr "Şimdi bir kez senkronize et"

#. translators: Third option of that setting: copy the preferences on every page load. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:93
msgid "Sync on every request (may affect performance)"
msgstr "Her istekte senkronize et (performansı etkileyebilir)"

#. translators: Heading of the second setting of the tool, about making field names translatable. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:100
msgid "Register Labels for Translation"
msgstr "Etiketleri çeviri için kaydet"

#. translators: Explanation under that heading. Keep "acf-json" in English: it is a folder name.
#: classes/Tools/LocalUI.php:104
msgid "Scans post types, taxonomies, options pages, and field groups stored in the \"acf-json\" directory, then registers their labels with WPML so you can translate them."
msgstr "“acf-json” dizininde saklanan yazı türlerini, taksonomileri, seçenekler sayfalarını ve alan gruplarını tarar, ardından etiketlerini WPML’e kaydeder, böylece onları çevirebilirsiniz."

#. translators: First option of the label-registration setting: leave the names alone.
#: classes/Tools/LocalUI.php:113
msgid "Don’t register labels"
msgstr "Etiketleri kaydetme"

#. translators: Second option of the label-registration setting: make the names translatable straight away. Verb phrase, imperative.
#: classes/Tools/LocalUI.php:120
msgid "Register labels now"
msgstr "Etiketleri şimdi kaydet"

#. translators: Button that saves the tool's settings and runs it. Verb, imperative.
#: classes/Tools/LocalUI.php:130
msgid "Apply"
msgstr "Uygula"

#. translators: Confirmation shown after the tool ran with syncing switched off.
#: classes/Tools/LocalUI.php:159
msgid "The synchronization of translation preferences is disabled."
msgstr "Çeviri tercihlerinin senkronizasyonu devre dışı bırakıldı."

#. translators: Confirmation shown after the tool copied the preferences once.
#: classes/Tools/LocalUI.php:164
msgid "Translation preferences synchronized."
msgstr "Çeviri tercihleri senkronize edildi."

#. translators: Confirmation shown after the tool ran with syncing switched on.
#: classes/Tools/LocalUI.php:169
msgid "The synchronization of translation preferences is enabled."
msgstr "Çeviri tercihlerinin senkronizasyonu etkinleştirildi."

#. translators: Item in the list of what the tool registered, joined with the others by "and". %s: how many field groups.
#: classes/Tools/LocalUI.php:235
#, php-format
msgid "%s group"
msgid_plural "%s groups"
msgstr[0] "%s grup"
msgstr[1] "%s grup"

#. translators: Item in the list of what the tool registered, joined with the others by "and". %s: how many post types.
#: classes/Tools/LocalUI.php:238
#, php-format
msgid "%s post type"
msgid_plural "%s post types"
msgstr[0] "%s yazı türü"
msgstr[1] "%s yazı türü"

#. translators: Item in the list of what the tool registered, joined with the others by "and". %s: how many taxonomies.
#: classes/Tools/LocalUI.php:241
#, php-format
msgid "%s taxonomy"
msgid_plural "%s taxonomies"
msgstr[0] "%s taksonomi"
msgstr[1] "%s taksonomi"

#. translators: Item in the list of what the tool registered, joined with the others by "and". %s: how many ACF options pages.
#: classes/Tools/LocalUI.php:244
#, php-format
msgid "%s options page"
msgid_plural "%s options pages"
msgstr[0] "%s seçenekler sayfası"
msgstr[1] "%s seçenekler sayfası"

#. translators: Result shown when the tool found nothing defined in code or in acf-json files.
#: classes/Tools/LocalUI.php:258
msgid "No local field groups, post types, taxonomies, or Options pages were found."
msgstr "Hiçbir yerel alan grubu, yazı türü, taksonomi veya Seçenekler sayfası bulunamadı."

#. translators: The word joining the only two items of a list, inside the sentence saying what the tool registered. Keep the space on each side.
#: classes/Tools/LocalUI.php:270
msgctxt "Used between elements of a two elements list"
msgid " and "
msgstr " ve "

#. translators: The comma and word placed before the last item of a list of three or more, inside the sentence saying what the tool registered. Keep the trailing space.
#: classes/Tools/LocalUI.php:276
msgctxt "Used before the last element of a three or more elements list"
msgid ", and "
msgstr ", ve "

#. translators: %s: List of registered labels.
#: classes/Tools/LocalUI.php:281
#, php-format
msgid "Successfully registered labels for %s."
msgstr "%s için etiketler başarıyla kaydedildi."

#. translators: %1$s and %2$s are placeholders for bold tags.
#: classes/TranslationDataMetaboxHooks.php:69
#, php-format
msgid "%1$sChange translation settings%2$s"
msgstr "%1$sÇeviri ayarlarını değiştir%2$s"

#. translators: %1$s and %2$s are placeholders for link tags.
#: classes/TranslationDataMetaboxHooks.php:86
#, php-format
msgid "%1$sTranslate labels%2$s"
msgstr "%1$sEtiketleri çevir%2$s"

#. translators: Status shown in the Multilingual Setup panel for a post type or taxonomy WPML does not translate. Adjective.
#: classes/TranslationDataTrait.php:44
msgid "Not translatable"
msgstr "Çevrilemez"

#. translators: Status shown in the Multilingual Setup panel for a post type or taxonomy WPML translates. Adjective.
#: classes/TranslationDataTrait.php:48
msgid "Translatable"
msgstr "Çevrilebilir"

#. translators: Second half of a status line in the Multilingual Setup panel; it follows "Translatable" and a dash. Lower case for that reason.
#: classes/TranslationDataTrait.php:62
msgid "only show translated items"
msgstr "sadece çevrilmiş öğeleri göster"

#. translators: Second half of a status line in the Multilingual Setup panel; it follows "Translatable" and a dash. Lower case for that reason.
#: classes/TranslationDataTrait.php:65
msgid "use translation if available or fallback to default language"
msgstr "varsa çeviriyi kullan veya varsayılan dile geri dön"

#. translators: %1$s: ACF field group name.
#: classes/TranslationEditor/DisableHooks.php:46
#, php-format
msgid "This content must be translated manually due to the translation option you selected for the \"%1$s\" field group."
msgstr "“%1$s” alan grubu için seçtiğiniz çeviri seçeneği nedeniyle bu içerik manuel olarak çevrilmelidir."
