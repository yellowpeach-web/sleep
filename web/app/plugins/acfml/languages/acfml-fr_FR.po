#. Plugin Name of the plugin
#: wpml-acf.php
msgid "Advanced Custom Fields Multilingual"
msgstr "Advanced Custom Fields Multilingual"

#. Plugin URI of the plugin
#: wpml-acf.php
msgid "https://wpml.org/documentation/wpml-core-and-add-on-plugins/acfml/"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/acfml/"

#. Description of the plugin
#: wpml-acf.php
msgid "Adds compatibility between WPML and Advanced Custom Fields | <a href=\"https://wpml.org/documentation/translating-your-contents/acf/?utm_source=plugin&utm_medium=gui&utm_campaign=acfml\">Documentation</a>"
msgstr "Ajoute une compatibilité entre WPML et Advanced Custom Fields | <a href=\"https://wpml.org/documentation/translating-your-contents/acf/?utm_source=plugin&utm_medium=gui&utm_campaign=acfml\">Documentation</a>"

#. Author of the plugin
#: wpml-acf.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: wpml-acf.php
msgid "http://www.onthegosystems.com/"
msgstr "http://www.onthegosystems.com/"

#. translators: Displayed when editing an ACF field in a translation, showing its value in the original language; %1$s and %2$s turn the string into bold, and %3$s is the actual original value.
#: classes/class-wpml-acf-field-annotations.php:82
#, php-format
msgctxt "Displayed when editing an ACF field in a translation, showing its value in the original language; %1$s and %2$s turn the string into bold, and %3$s is the actual original value."
msgid "%1$sOriginal%2$s: %3$s"
msgstr "%1$sOriginal%2$s : %3$s"

#. translators: Note under a field in the translation editor. The quoted text is the name of a translation preference and is translated the same way in the preference list.
#: classes/class-wpml-acf-field-annotations.php:161
msgid "This type of ACF field will always be set to \"Copy once\"."
msgstr "Ce type de champ ACF sera toujours réglé sur « Copier une seule fois »."

#. translators: Label of the field's name in the note shown under a field in the translation editor; the name follows the colon.
#: classes/class-wpml-acf-field-annotations.php:166
msgid "ACF field name:"
msgstr "Nom du champ ACF :"

#. translators: Label of the field's kind in the note shown under a field in the translation editor; the kind follows the colon.
#: classes/class-wpml-acf-field-annotations.php:169
msgid "ACF field type:"
msgstr "Type de champ ACF :"

#. translators: Label of the radio group on an ACF field that sets how the field is translated.
#: classes/class-wpml-acf-field-settings.php:99
msgid "Translation preferences"
msgstr "Préférences de traduction"

#. translators: Explanation under the translation-preferences radio group of an ACF field.
#: classes/class-wpml-acf-field-settings.php:101
msgid "What to do with field's value when post/page is going to be translated"
msgstr "Que faire de la valeur du champ lorsque la publication/page va être traduite"

#. translators: Option kept on a field that was already set to Translate, for a field type where the option is no longer offered. "Translate" is the preference's name, translated the same way in the preference list.
#: classes/class-wpml-acf-field-settings.php:243
msgid "Translate (your current setting, no longer offered for this field type)"
msgstr "Traduire (votre réglage actuel, n’est plus proposé pour ce type de champ)"

#. translators: Explanation under the Translate option that was kept on a field type where it is no longer offered.
#: classes/class-wpml-acf-field-settings.php:334
msgid "Kept because it is your current setting. This value is no longer offered for this field type."
msgstr "Conservé car il s’agit de votre réglage actuel. Cette valeur n’est plus proposée pour ce type de champ."

#. translators: Warning under a translation preference that WPML advises against for the field being edited.
#: classes/class-wpml-acf-field-settings.php:339
msgid "Not recommended for this field type."
msgstr "Non recommandé pour ce type de champ."

#. translators: First line describing the "Don't translate" preference of an ACF field.
#: classes/class-wpml-acf-field-settings.php:354
msgid "Translated pages start without this content."
msgstr "Les pages traduites commencent sans ce contenu."

#. translators: Second line describing the "Don't translate" preference of an ACF field.
#: classes/class-wpml-acf-field-settings.php:356
msgid "Editable in other languages, and starts empty."
msgstr "Modifiable dans d’autres langues, et commence vide."

#. translators: First line describing the "Copy" preference of an ACF field.
#: classes/class-wpml-acf-field-settings.php:360
msgid "Visitors in every language always see exactly what the original shows."
msgstr "Les visiteurs de chaque langue voient toujours exactement ce que l’original affiche."

#. translators: Second line describing the "Copy" preference of an ACF field; "it" is the field.
#: classes/class-wpml-acf-field-settings.php:362
msgid "Shown locked in other languages, so it cannot be edited there."
msgstr "Affiché comme verrouillé dans les autres langues, il ne peut donc pas y être modifié."

#. translators: First line describing the "Copy once" preference of an ACF field.
#: classes/class-wpml-acf-field-settings.php:366
msgid "Starts the same as the original, then each language goes its own way."
msgstr "Commence de la même manière que l’original, puis chaque langue suit son propre chemin."

#. translators: Second line describing the "Copy once" preference of an ACF field.
#: classes/class-wpml-acf-field-settings.php:368
msgid "Editable in every language, and permanently yours to maintain by hand."
msgstr "Modifiable dans chaque langue, et reste à votre charge pour une maintenance manuelle."

#. translators: First line describing the "Translate" preference of an ACF field; "this" is the field's value.
#: classes/class-wpml-acf-field-settings.php:372
msgid "Visitors see this in their own language."
msgstr "Les visiteurs voient ceci dans leur propre langue."

#. translators: Second line describing the "Translate" preference of an ACF field.
#: classes/class-wpml-acf-field-settings.php:374
msgid "Filled by the translation and edited in the translation editor."
msgstr "Rempli par la traduction et modifié dans l’éditeur de traduction."

#. translators: Tooltip of the warning icon next to a field whose translation preference has not been chosen.
#: classes/class-wpml-acf-field-settings.php:900
msgid "Edit the field to set the translation preference."
msgstr "Modifiez le champ pour définir la préférence de traduction."

#. translators: Admin notice shown while the plugin updates preferences in the background. "ACFML" is the plugin's short name and "Gutenberg" is the WordPress editor's name; both stay in English.
#: classes/class-wpml-acf-migrate-block-preferences.php:67
msgid "ACFML is updating translation preferences for strings in Gutenberg Blocks. Keep using your site as usual. This notice will disappear when the process is done."
msgstr "ACFML met à jour les préférences de traduction pour les chaînes dans les blocs Gutenberg. Continuez à utiliser votre site comme d’habitude. Cet avis disparaîtra une fois le processus terminé."

#. translators: Admin notice shown when the plugin is active but WPML is not; "It" is this plugin.
#: classes/class-wpml-acf-requirements.php:30
msgid "ACFML is enabled but not effective. It requires WPML in order to work."
msgstr "ACFML est activé mais n’est pas effectif. Il nécessite WPML pour fonctionner."

#. translators: Admin notice shown when this plugin is active but Advanced Custom Fields is not; "It" is this plugin.
#: classes/class-wpml-acf-requirements.php:49
msgid "ACFML is enabled but not effective. It requires Advanced Custom Fields or ACF PRO in order to work."
msgstr "ACFML est activé mais inopérant. Il nécessite Advanced Custom Fields ou ACF PRO pour fonctionner."

#. translators: Button on the notice shown when Advanced Custom Fields is installed but not active.
#: classes/class-wpml-acf-requirements.php:64
msgid "Activate Advanced Custom Fields"
msgstr "Activer Advanced Custom Fields"

#. translators: Button on the notice shown when Advanced Custom Fields is not installed.
#: classes/class-wpml-acf-requirements.php:81
msgid "Install Advanced Custom Fields"
msgstr "Installer Advanced Custom Fields"

#. translators: First sentence of the admin notice about the ACF field group post type being translatable. The quoted word is the setting's value in WPML and is translated the same way there.
#: classes/class-wpml-acf-translatable-groups-checker.php:160
msgid "Field groups are set to \"Translatable\" in WPML settings, which prevents ACF fields from being translated."
msgstr "Les groupes de champs sont réglés sur « Traduisible » dans les paramètres de WPML, ce qui empêche la traduction des champs ACF."

#. translators: Second sentence of that notice; "This" is the field groups being set to Translatable.
#: classes/class-wpml-acf-translatable-groups-checker.php:162
msgid "This is almost never intended."
msgstr "Ceci n’est presque jamais intentionnel."

#. translators: Line in that notice when the setting comes from a file. Keep the file name in English; "Not translatable" is the setting's value in WPML.
#: classes/class-wpml-acf-translatable-groups-checker.php:168
msgid "A configuration file (wpml-config.xml) controls this setting on this site, so it cannot be changed from here. Edit that file, or ask whoever maintains it to set the ACF field group post type to Not translatable."
msgstr "Un fichier de configuration (wpml-config.xml) contrôle ce réglage sur ce site, il ne peut donc pas être modifié d’ici. Modifiez ce fichier ou demandez à la personne qui le gère de régler le type de publication du groupe de champs ACF sur « Ne pas traduire »."

#. translators: Last line of that notice; "them" are the copies of the field groups.
#: classes/class-wpml-acf-translatable-groups-checker.php:172
msgid "Field group copies already created in other languages stay on the site. Changing this setting does not delete them."
msgstr "Les copies de groupes de champs déjà créées dans d’autres langues restent sur le site. La modification de ce réglage ne les supprime pas."

#. translators: Button in the admin notice about translatable field groups; it applies the fix. "Not translatable" is the setting's value in WPML and is translated the same way there. Verb phrase, imperative.
#: classes/class-wpml-acf-translatable-groups-checker.php:194
msgid "Set field groups to Not translatable"
msgstr "Régler les groupes de champs sur « Ne pas traduire »"

#. translators: Link in that notice; it opens the ACFML documentation.
#: classes/class-wpml-acf-translatable-groups-checker.php:205
msgid "Why this matters"
msgstr "Pourquoi est-ce important ?"

#. translators: %d is the number of posts using this field group.
#: classes/FieldGroup/AttachedPosts.php:108
#, php-format
msgid "If any field is set to \"Translatable\", WPML will re-translate the %d posts using this field group."
msgstr "Si un champ est réglé sur « Traduire », WPML retraduira les %d publications utilisant ce groupe de champs."

#. translators: Warning shown before a field group's translation option is changed, when the update will take under a minute.
#: classes/FieldGroup/AttachedPosts.php:121
msgid "Some posts using this field group have translations. Once you change the translation option, WPML needs to update the translation status of the posts. This can take up to 1 minute."
msgstr "Certaines publications utilisant ce groupe de champs ont des traductions. Une fois que vous aurez modifié l’option de traduction, WPML devra mettre à jour le statut de traduction des publications. Cela peut prendre jusqu’à 1 minute."

#. translators: %d is the number of hours.
#: classes/FieldGroup/AttachedPosts.php:124
#, php-format
msgid "Some posts using this field group have translations. Once you change the translation option, WPML needs to update the translation status of the posts. This can take up to %d hours."
msgstr "Certaines publications utilisant ce groupe de champs ont des traductions. Une fois que vous aurez modifié l’option de traduction, WPML devra mettre à jour le statut de traduction des publications. Cela peut prendre jusqu’à %d heures."

#. translators: %d is the number of minutes.
#: classes/FieldGroup/AttachedPosts.php:128
#, php-format
msgid "Some posts using this field group have translations. Once you change the translation option, WPML needs to update the translation status of the posts. This can take up to %d minutes."
msgstr "Certaines publications utilisant ce groupe de champs ont des traductions. Une fois que vous aurez modifié l’option de traduction, WPML devra mettre à jour le statut de traduction des publications. Cela peut prendre jusqu’à %d minutes."

#. translators: Tooltip of the padlock next to a post type's translation setting that WPML holds; "it" is that setting.
#: classes/FieldGroup/CptLockHooks.php:162
msgid "Locked by WPML so that ACF fields stay translatable. Click here to unlock and change it anyway."
msgstr "Verrouillé par WPML pour que les champs ACF restent traduisibles. Cliquez ici pour déverrouiller et modifier quand même."

#. translators: Title of the notice on a field group whose taxonomy cannot be translated yet. Verb phrase, imperative.
#: classes/FieldGroup/DetectNonTranslatableLocations.php:154
msgid "Set translation preferences for the attached taxonomy"
msgstr "Définir les préférences de traduction pour la taxonomie jointe"

#. translators: Title of the notice on a field group whose post type cannot be translated yet. Verb phrase, imperative.
#: classes/FieldGroup/DetectNonTranslatableLocations.php:156
msgid "Set translation preferences for the attached post type"
msgstr "Définir les préférences de traduction pour le type de publication joint"

#. translators: Body of the notice on a field group whose taxonomy cannot be translated yet. Keep the trailing space: a link follows on the same line.
#: classes/FieldGroup/DetectNonTranslatableLocations.php:178
msgid "If you want to translate your fields, go to the WPML Settings page and make the taxonomy attached to this field group translatable. "
msgstr "Si vous souhaitez traduire vos champs, allez sur la page des paramètres de WPML et rendez traduisible la taxonomie jointe à ce groupe de champs. "

#. translators: %1$s and %2$s will wrap the string in a <a> link html tag
#: classes/FieldGroup/DetectNonTranslatableLocations.php:181
#, php-format
msgid "If you want to translate your fields, go to the WPML Settings page and %1$smake the post type attached to this field group translatable%2$s."
msgstr "Si vous souhaitez traduire vos champs, allez sur la page des paramètres de WPML et %1$srendez traduisible le type de publication joint à ce groupe de champs%2$s."

#. translators: Name of the field group translation mode where each field's preference is set by hand. Noun used as a mode name.
#: classes/FieldGroup/Mode.php:62
msgid "Expert"
msgstr "Expert"

#. translators: Name of the field group translation mode where the fields are sent for translation.
#: classes/FieldGroup/Mode.php:64
msgid "Same content in every language, translated"
msgstr "Même contenu dans chaque langue, traduit"

#. translators: Name of the field group translation mode where every language keeps its own field values.
#: classes/FieldGroup/Mode.php:66
msgid "Each language has its own content"
msgstr "Chaque langue a son propre contenu"

#. translators: Explanation shown on a repeater, group or flexible-content field. "Translate" is the name of a translation preference and is translated the same way it is in the preference list.
#: classes/FieldGroup/ModeValidity.php:152
msgid "Translate is not offered on container fields, because it replaces the value your theme reads. The fields inside carry their own preferences."
msgstr "L’option « Traduire » n’est pas proposée pour les champs conteneurs, car elle remplace la valeur lue par votre thème. Les champs à l’intérieur portent leurs propres préférences."

#. translators: Explanation shown on a URL field. "Translate" is the name of a translation preference.
#: classes/FieldGroup/ModeValidity.php:158
msgid "Translate lets each language point at its own address, which an external link often needs. A link to a page on this site already points at that page in the reader's language, so leave it as it is."
msgstr "« Traduire » permet à chaque langue de pointer vers sa propre adresse, ce dont un lien externe a souvent besoin. Un lien vers une page de ce site pointe déjà vers cette page dans la langue du lecteur, laissez-le donc tel quel."

#. translators: Explanation shown on a link field, which stores a link text, a URL and a target.
#: classes/FieldGroup/ModeValidity.php:161
msgid "Translate sends the link text and the URL. The target keeps the value you set, and a URL you leave as it is points at the page in the reader's language."
msgstr "« Traduire » envoie le texte du lien et l'URL. La cible conserve la valeur que vous avez définie, et une URL que vous laissez telle quelle pointe vers la page dans la langue du lecteur."

#. translators: Explanation shown on an e-mail field for why translation is not offered.
#: classes/FieldGroup/ModeValidity.php:164
msgid "Translating an address produces one that does not exist. An e-mail address is the same in every language."
msgstr "Traduire une adresse produit une adresse qui n’existe pas. Une adresse e-mail est la même dans toutes les langues."

#. translators: Explanation shown on a colour-picker field for why translation is not offered.
#: classes/FieldGroup/ModeValidity.php:167
msgid "A color code is not language content. Translating it changes the color your visitors see."
msgstr "Un code couleur n’est pas un contenu linguistique. Le traduire modifie la couleur que voient vos visiteurs."

#. translators: Explanation shown on a date or time field for why translation is not offered.
#: classes/FieldGroup/ModeValidity.php:172
msgid "The stored value is a fixed date format that your theme reads. Translating it breaks the format."
msgstr "La valeur stockée est un format de date fixe lu par votre thème. La traduire casse le format."

#. translators: Explanation shown on a select, checkbox, radio or button-group field for why translation is not offered. Keep the bold tags around the WPML screen name.
#: classes/FieldGroup/ModeValidity.php:178
msgid "The stored value is the choice key, not the label your visitors see. Translating it stops the key from matching your choices. Translate the labels in <b>String Translation</b> instead."
msgstr "La valeur stockée est la clé du choix, pas le libellé que voient vos visiteurs. La traduire empêche la clé de correspondre à vos choix. Traduisez plutôt les libellés dans la <b>Traduction de chaînes</b>."

#. translators: Explanation shown on a number or true/false field for why translation is not offered.
#: classes/FieldGroup/ModeValidity.php:182
msgid "This value is read by your theme or plugin code. A translated value can stop matching what the code expects."
msgstr "Cette valeur est lue par le code de votre thème ou de votre extension. Une valeur traduite peut ne plus correspondre à ce que le code attend."

#. translators: Line in the tooltip of a field whose translation preference comes from a wpml-config.xml file; "this" is the preference.
#: classes/FieldGroup/PreferenceSource.php:354
msgid "The file decides this again on every import, so changes made elsewhere do not stick."
msgstr "Le fichier en décide à nouveau lors de chaque importation, les modifications effectuées ailleurs ne sont donc pas conservées."

#. translators: %s is a configuration file path, for example themes/acme/wpml-config.xml.
#: classes/FieldGroup/PreferenceSource.php:357
#, php-format
msgid "Edit %s, or remove the entry there, to manage this field on this screen."
msgstr "Modifiez %s, ou supprimez l’entrée correspondante, pour gérer ce champ sur cet écran."

#. translators: Last line of the tooltip of a field whose preference comes from a configuration file whose path is unknown.
#: classes/FieldGroup/PreferenceSource.php:359
msgid "Edit the configuration file, or remove the entry there, to manage this field on this screen."
msgstr "Modifiez le fichier de configuration, ou supprimez l’entrée correspondante, pour gérer ce champ sur cet écran."

#. translators: Warning in the tooltip when the stored preference of a field differs from the one now chosen on the screen.
#: classes/FieldGroup/PreferenceSource.php:371
msgid "That is not the value selected above. Saving this field group applies the value above."
msgstr "Ce n’est pas la valeur sélectionnée ci-dessus. L’enregistrement de ce groupe de champs applique la valeur ci-dessus."

#. translators: %s is a local JSON file path, for example acf-json/group_640ab1.json.
#: classes/FieldGroup/PreferenceSource.php:377
#, php-format
msgid "This field group is also in %s. That file re-applies these settings the next time the group is synced."
msgstr "Ce groupe de champs se trouve également dans %s. Ce fichier réappliquera ces réglages lors de la prochaine synchronisation du groupe."

#. translators: First line of the tooltip of a field whose translation preference the theme sets. Keep the file name in English.
#: classes/FieldGroup/PreferenceSource.php:397
msgid "Locked. Managed by your theme, in its wpml-config.xml file."
msgstr "Verrouillé. Géré par votre thème, dans son fichier wpml-config.xml."

#. translators: First line of the tooltip of a field whose translation preference a plugin sets. Keep the file name in English.
#: classes/FieldGroup/PreferenceSource.php:401
msgid "Locked. Managed by a plugin, in its wpml-config.xml file."
msgstr "Verrouillé. Géré par une extension, dans son fichier wpml-config.xml."

#. translators: First line of the tooltip of a field whose translation preference comes from a configuration file WPML fetched.
#: classes/FieldGroup/PreferenceSource.php:405
msgid "Locked. Managed by a configuration file WPML downloaded for one of your plugins or themes."
msgstr "Verrouillé. Géré par un fichier de configuration que WPML a téléchargé pour l’une de vos extensions ou l’un de vos thèmes."

#. translators: First line of the tooltip of a field whose translation preference comes from the XML the site owner pasted into WPML's settings.
#: classes/FieldGroup/PreferenceSource.php:409
msgid "Locked. Managed by the custom XML configuration saved in WPML settings."
msgstr "Verrouillé. Géré par la configuration XML personnalisée enregistrée dans les paramètres de WPML."

#. translators: First line of the tooltip of a field whose translation preference comes from a configuration file WPML cannot name.
#: classes/FieldGroup/PreferenceSource.php:413
msgid "Locked. Managed by a configuration file on this site."
msgstr "Verrouillé. Géré par un fichier de configuration sur ce site."

#. translators: %s is another field group's title.
#: classes/FieldGroup/PreferenceSource.php:428
#, php-format
msgid "Set in the field group \"%s\", which uses the same field name."
msgstr "Défini dans le groupe de champs « %s », qui utilise le même nom de champ."

#. translators: Line in the tooltip saying where a field's translation preference comes from, when the JSON file's path is unknown.
#: classes/FieldGroup/PreferenceSource.php:439
msgid "Set in the field group's local JSON file."
msgstr "Défini dans le fichier JSON local du groupe de champs."

#. translators: %s is a local JSON file path, for example acf-json/group_640ab1.json.
#: classes/FieldGroup/PreferenceSource.php:442
#, php-format
msgid "Set in the field group's local JSON file, %s."
msgstr "Défini dans le fichier JSON local du groupe de champs, %s."

#. translators: Line in the tooltip saying where a field's translation preference comes from.
#: classes/FieldGroup/PreferenceSource.php:448
msgid "Registered with PHP by your theme or a plugin."
msgstr "Enregistré avec PHP par votre thème ou une extension."

#. translators: Link in the tooltip saying where a field's translation preference comes from; "Custom Fields Translation" is the name of the section on that screen.
#: classes/FieldGroup/PreferenceSource.php:453
msgid "Set on the WPML Settings screen (Custom Fields Translation)."
msgstr "Défini sur l’écran des paramètres de WPML (Traduction des champs personnalisés)."

#. translators: Line in the tooltip saying that a field's translation preference was set on the field group screen the reader is looking at.
#: classes/FieldGroup/PreferenceSource.php:458
msgid "Set here, on this screen."
msgstr "Défini ici, sur cet écran."

#. translators: Line in the tooltip saying what a field's current translation preference does.
#: classes/FieldGroup/PreferenceSource.php:481
msgid "Right now this field is translated, so visitors see it in their own language."
msgstr "Actuellement, ce champ est traduit, les visiteurs le voient donc dans leur propre langue."

#. translators: Line in the tooltip saying what a field's current translation preference does.
#: classes/FieldGroup/PreferenceSource.php:485
msgid "Right now this field stays identical in every language."
msgstr "Actuellement, ce champ reste identique dans chaque langue."

#. translators: Line in the tooltip saying what a field's current translation preference does.
#: classes/FieldGroup/PreferenceSource.php:489
msgid "Right now this field starts as a copy in every language, then each language keeps its own."
msgstr "Actuellement, ce champ commence par une copie dans chaque langue, puis chaque langue conserve la sienne."

#. translators: Line in the tooltip saying what a field's current translation preference does.
#: classes/FieldGroup/PreferenceSource.php:493
msgid "Right now this field stays out of translations."
msgstr "Actuellement, ce champ reste en dehors des traductions."

#. translators: Name of the translation preference that leaves a field out of translations. Verb phrase, imperative.
#: classes/FieldGroup/PreferenceSource.php:509
msgid "Don't translate"
msgstr "Ne pas traduire"

#. translators: Name of the translation preference that gives every language the original's value. Verb, imperative: the action, not a duplicate.
#: classes/FieldGroup/PreferenceSource.php:511
msgid "Copy"
msgstr "Copier"

#. translators: Name of the translation preference that seeds each language from the original and then lets it diverge. Verb phrase, imperative.
#: classes/FieldGroup/PreferenceSource.php:513
msgid "Copy once"
msgstr "Copier une seule fois"

#. translators: Name of the translation preference that sends a field for translation. Verb, imperative: the action, not the noun "translation".
#: classes/FieldGroup/PreferenceSource.php:515
msgid "Translate"
msgstr "Traduire"

#. translators: Label of the count of ACF field groups on the setup notice. Noun, plural.
#: classes/FieldGroup/PreflightHooks.php:111
msgid "Field groups"
msgstr "Groupes de champs"

#. translators: Label of the count of ACF fields on the setup notice, and the column heading for that count on the translation setup screen. Noun, plural.
#: classes/FieldGroup/PreflightHooks.php:113
#: classes/FieldGroup/SetupScreen.php:188
msgid "Fields"
msgstr "Champs"

#. translators: Label of the count of posts using these field groups, on the setup notice. Noun, plural.
#: classes/FieldGroup/PreflightHooks.php:115
msgid "Posts"
msgstr "Publications"

#. translators: Button on the setup notice that opens the ACF field-groups list; "them" are the field groups. Verb phrase, imperative.
#: classes/FieldGroup/PreflightHooks.php:124
msgid "Review them one by one"
msgstr "Les examiner un par un"

#. translators: %d is the number of field groups that have no translation setup.
#: classes/FieldGroup/PreflightHooks.php:140
#, php-format
msgid "Apply the recommended setup to %d group"
