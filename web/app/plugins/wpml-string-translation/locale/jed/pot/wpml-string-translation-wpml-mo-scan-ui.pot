#: src/js/mo-scan/pre-generate/UI.js:46
#. Title of the dialog that asks the user to let WPML write the translation files.
msgid "WPML needs to generate .mo files"
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:29
#. Text in the dialog that asks the user to let WPML write the translation files, when the folder for those files cannot be written to. The product name stays in English.
msgid ""
"WPML String Translation uses .mo files instead of database calls. WPML "
"needs to generate these .mo files in order for translations to appear on "
"the front-end. However, the folder that should hold these .mo files is not "
"open for writing."
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:32
#. Line above the path of the folder that has to be made writable, in the dialog that asks the user to let WPML write the translation files.
msgid ""
"Please use your admin control panel or an FTP program to make the following "
"folder writeable:"
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:42
#. Heading in the dialog that asks the user to let WPML write the translation files, shown when writing them failed.
msgid "There was a problem creating the .mo files"
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:46
#. Line under the heading "There was a problem creating the .mo files". "Admin Texts Translation" is the name of a WPML admin page; the words between the <a> tags become a link to it.
msgid ""
"You can try again now or try again later on the <a><b>Admin Texts "
"Translation</b></a> page."
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:55
#. Heading in the dialog that asks the user to let WPML write the translation files, shown when the user closes it without letting WPML write them.
msgid "Translations are missing from the front-end until you generate .mo files"
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:59
#. Line under the heading "Translations are missing from the front-end until you generate .mo files". "Admin Texts Translation" is the name of a WPML admin page; the words between the <a> tags become a link to it.
msgid ""
"Your site doesn't have the .mo files that WPML needs in order to display "
"translated strings on the front-end. To generate these .mo files, remember "
"to go to the <a><b>Admin Texts Translation</b></a> page."
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:66
#. Text in the dialog that asks the user to let WPML write the translation files, before anything has gone wrong. The product name stays in English.
msgid ""
"WPML String Translation uses .mo files instead of database calls. WPML "
"needs to generate these .mo files in order for translations to appear on "
"the front-end."
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:74
#. Button label in the dialog that asks the user to let WPML write the translation files, shown after writing them failed: it tries once more. Verb phrase, imperative.
msgid "Try again"
msgstr ""

#: src/js/mo-scan/pre-generate/textProvider.js:77
#. Button label that lets WPML write the translation files, in the dialog that asks for it. Verb phrase, imperative.
msgid "Generate .mo files"
msgstr ""

